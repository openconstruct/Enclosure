<?xml version="1.0" encoding="UTF-8"?>
<!-- Martin Hughes, council grants officer. Formal. Confused by slang. -->
<aiml>
  <category><pattern>*</pattern><template>
    <think>
      <set var="slang"><srai>XSLANG <star/></srai></set>
      <set var="ref"><srai>XREF <star/></srai></set>
    </think>
    <condition>
      <li name="done" value="yes"></li>
      <li var="slang" value="yes">Dear Greenshoots,<br/><br/>Thank you for your email. I'm afraid I found parts of it hard to follow. Could you confirm the amount requested, the grant reference, and what the funding is for?<br/><br/>Kind regards,<br/>Martin Hughes<br/>Grants Officer, Harlow Vale Council</li>
      <li var="ref" value="yes"><think><set name="done">yes</set></think>Dear Greenshoots,<br/><br/>Thank you, your application (CGS-2026-114) has been received and will go to the panel on 14 October.<br/><br/>Kind regards,<br/>Martin Hughes<br/>Grants Officer, Harlow Vale Council</li>
      <li>Dear Greenshoots,<br/><br/>Thank you for your email. Could you include your grant reference so I can match it to your application?<br/><br/>Kind regards,<br/>Martin Hughes</li>
    </condition>
  </template></category>
</aiml>
